{
  "name": "@ariponly/nanoai",
  "version": "1.0.2",
  "description": "NanoAI — a personal AI agent on your own machine: terminal chat, gateway API with live streaming, and a workspace where it reads, writes, and organizes files for you.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "assistant",
    "gateway"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#client": "./apps/client/index.js"
  },
  "bin": {
    "nanoai": "./bin/nanoai.js"
  },
  "files": [
    "./bin/",
    "./gateway/",
    "./src/",
    "./apps/client/",
    "./apps/cli/",
    "./apps/console/",
    "./apps/web/dist",
    "./scripts/",
    "./app.jsx",
    "./config/models.json",
    "./config/nano.config.example.json",
    "./README.md",
    "./LICENSE"
  ],
  "scripts": {
    "chat": "npx tsx app.jsx",
    "build:web": "npm run build --prefix apps/web",
    "prepack": "npm run build:web",
    "start": "node gateway/server.js",
    "test": "node --test --import ./test/setup.js \"test/suite/*.test.js\" \"test/contracts/*.test.js\" \"test/integration/*.test.js\"",
    "test:suite": "node --test --import ./test/setup.js \"test/suite/*.test.js\"",
    "test:contracts": "node --test --import ./test/setup.js \"test/contracts/*.test.js\"",
    "test:integration": "node --test --import ./test/setup.js \"test/integration/*.test.js\"",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@google/genai": "^2.10.0",
    "better-sqlite3": "^12.11.1",
    "cli-spinners": "^3.4.0",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "docx": "^9.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "htmlparser2": "^12.0.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "mammoth": "^1.13.0",
    "marked": "^15.0.7",
    "openai": "^7.39.0",
    "react": "^19.2.8",
    "tsx": "^4.23.1",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
